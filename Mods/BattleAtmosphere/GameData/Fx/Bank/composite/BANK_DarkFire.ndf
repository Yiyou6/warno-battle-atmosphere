export BANK_Test_DarkFire is Simultaneous
(
    Mobile = MobileUnCentroid()
    Actions =
    [
        export TestFireAC is Template_ActionCall
        (
            Action = ~/BANK_DarkFireCompo
            NamedParameters = MAP[
                ( 'BANK_Radius', RandomRange[1100, 1300]),
                ( 'BANK_Lifetime', 600 ),
                ( 'BANK_ScaleFactor', 1 ),
                ( 'BANK_FLammeSizeMul', RandomRange[2, 6] ),
                ( 'BANK_PCount_FireMul', RandomRange[0.33, 0.66] * $/VFX_Bank/FxLodLevel_from_05to1 ),
                ( 'BANK_PCount_SmokeMul', RandomRange[4, 8] * $/VFX_Bank/FxLodLevel_from_05to1 ),
                ( 'BANK_PCount_SparksMul', 0 ),
                ( 'BANK_PCount_SmokeStarterMul', RandomRange[1, 2] * $/VFX_Bank/FxLodLevel_from_05to1 ),
            ]

        ),
    ]
)

export BANK_DarkFireCompo is SimultaneousActionDeclaration
(
    Params =
    [
        private BANK_Radius is Template_ActionAlias
        (
            ExpectedType = 'float'
            DefaultValue = 3000
        ),
        private BANK_Lifetime is Template_ActionAlias
        (
            ExpectedType = 'float'
            DefaultValue = 120
        ),
        private BANK_ScaleFactor is Template_ActionAlias
        (
            ExpectedType = 'float'
            DefaultValue = RandomRange[0.75, 1.25] * 10
        ),
        private BANK_FLammeSizeMul is Template_ActionAlias
        (
            ExpectedType = 'float'
            DefaultValue = RandomRange[0.1, 0.2]
        ),
        private BANK_PCount_FireMul is Template_ActionAlias
        (
            ExpectedType = 'float'
            DefaultValue = 0.5
        ),
        private BANK_PCount_SmokeMul is Template_ActionAlias
        (
            ExpectedType = 'float'
            DefaultValue = 1
        ),
        private BANK_PCount_SparksMul is Template_ActionAlias
        (
            ExpectedType = 'float'
            DefaultValue = 1
        ),
        private BANK_PCount_SmokeStarterMul is Template_ActionAlias
        (
            ExpectedType = 'float'
            DefaultValue = 1
        ),
    ]
    Actions =
    [
        export Fire_ALL is Simultaneous
        (
            Mobile = Template_MobileWithLocalRepereMatrixFactory
            (
                Position = float3[0.00, 0.00, 0.00]
                IntroduceCentroid = false //True
                InitialScale = BANK_ScaleFactor
                MaxScale = 1
                CentroidRelative = True
            )
            Actions =
            [
                export Feu1 is Template_ActionCall
                (
                    Action = ~/BANK_DarkFire_AD
                    NamedParameters = MAP[
                        ( 'Feu_Size_Mul', BANK_FLammeSizeMul * RandomRange[0.1, 0.2] ),
                        ( 'Duration', ~/BANK_DarkFireCompo/BANK_Lifetime ),
                        ( 'Ground_Size', ~/BANK_DarkFireCompo/BANK_Radius ),
                        ( 'PCount_FireMul', BANK_PCount_FireMul ),
                        ( 'PCount_SmokeMul', BANK_PCount_SmokeMul ),
                        ( 'PCount_SparksMul', BANK_PCount_SparksMul ),
                        ( 'PCount_SmokeStarterMul', BANK_PCount_SmokeStarterMul ),
                    ]
                ),
            ]
        ),
    ]
)

public BANK_DarkFire_AD is SimultaneousActionDeclaration
(
    Params =
    [
        public Feu_Size_Mul is Template_ActionAlias
        (
            ExpectedType = 'any'
            DefaultValue = 1
        ),
        public Duration is Template_ActionAlias
        (
            ExpectedType = 'any'
            DefaultValue = 120
        ),
        public Ground_Size is Template_ActionAlias
        (
            ExpectedType = 'any'
            DefaultValue = 5000
        ),
        public PCount_FireMul is Template_ActionAlias
        (
            ExpectedType = 'float'
            DefaultValue = 1
        ),
        private PCount_SmokeMul is Template_ActionAlias
        (
            ExpectedType = 'float'
            DefaultValue = 1
        ),
        private PCount_SparksMul is Template_ActionAlias
        (
            ExpectedType = 'float'
            DefaultValue = 1
        ),
        public PCount_SmokeStarterMul is Template_ActionAlias
        (
            ExpectedType = 'float'
            DefaultValue = 1
        ),
    ]
    Actions =
    [
        Template_ActionCall(Action = $/VFX_Bank/BA_BridgeWindSmoke_Finite NamedParameters = MAP[('parDuration', Duration),]),

        public ALL is TSimultaneousActionWithMultiLaunchLimit
        (
            Actions =
            [
                private OLDKILL is WaitInSec
                (
                    Duration = Duration * 1.1
                ),
                private flammes is ParticleBombSpawner
                (
                    ParticleMaxDurationForSpawnSkip = (Duration + 20) * 1.1
                    Count = 1
                    Spawner = private Spawner is ParticleSpawner
                    (
                        ParticleLifetime = Duration
                        Initialisers =
                        [
                            ParticleInitialiserList
                            (
                                ColorModifier = float3[1, 1, 1]

                                Size = Ground_Size
                                ColorRGB = LinearColor[1.00, 1.00, 1.00]
                                Alpha = 1
                                ColorMultiplier = 1
                                CustomFloat_1 = Feu_Size_Mul
                                CustomFloat_2 = PCount_FireMul * RandomRange[0.33, 0.66]
                                CustomFloat_3 = 1
                                CustomFloat_4 = 0.5
                                CustomFloat_6 = 100
                            ),
                            Initialiser_SetMobileWrapper(),
                        ]
                        ParticleDescriptor = ParticleDescriptor
                        (
                            ParticleRenderer = $/VFX_Bank/NullRenderer
                            RenderInfo = $/VFX_Bank/NullRenderInfo
                            Evolvers = Template_List
                            (
                                Evolvers =
                                [
                                Template_EvolverField
                                (
                                    EvolveFunction = ParticleMobileWrapperPositionUnScaled
                                    Field = 'Position'
                                ),
                                private flammes_spawner is EvolverSpraySpawner
                                (
                                    Frequency = lerp[$/VFX_Bank/FxLodLevel_For_Particle, 1, lerp[Triangle[ParticleLifeRatio], 10, 7 + ( ParticleSize * 0.002 )]] * ( 0.5 * ParticleCustomFloat_3 ) * ParticleCustomFloat_2
                                    MaxSpawnedParticleLifetime = 20
                                    Spawner = private Flammes_Spawner is ParticleSpawner
                                    (
                                        ParticleLifetime = RandomRange[5, 10] * 2
                                        private groundSize is ifte[SpawningParticleCustomFloat_4 == 1, lerp[sat[SpawningParticleLifeRatio * 2], ( SpawningParticleSize * 0.075 ), ( SpawningParticleSize * 0.1 )], ( SpawningParticleSize * 0.1 )]
                                        Initialisers =
                                        [
                                            private particules_flammes is ParticleInitialiserList
                                            (
                                                Size = 300
                                                Alpha = 1.0
                                                ColorMultiplier = 1.0

                                                Position = ( $/VFX_Bank/MinusOneToOneRandomDisc * groundSize * lerp[sat[SpawningParticleLifeRatio * 3], SpawningParticleCustomFloat_3, 1] ) + GenFloat3[0, 0, SpawningParticleCustomFloat_6]
                                                Speed = float3[0.00, 0.00, 0.00] + ( $/VFX_Bank/MinusOneToOneRandomHemisphereVolume * 0 * Triangle[SpawningParticleLifeRatio] * 0.1 )
                                                ColorModifier = LinearColor[0.75, 1.00, 1.00]
                                                EmissivePower = 0
                                                Rotation = RandomRange[-0.02, 0.02]
                                                Opacity = 0
                                                CustomFloat_1 = ParticleSize * RandomRange[1, 4]
                                                CustomFloat_2 = SpawningParticleCustomFloat_1
                                                CustomFloat_3 = RandomRange[1.33, 1.66]
                                                CustomFloat_4 = RandomRange[0.5, 1]
                                                CustomFloat_5 = SpawningParticleCustomFloat_4
                                                CustomFloat_6 = 1 - MapToLinearSmoothStep[SpawningParticleElapsedTime, SpawningParticleDuration - ParticleDuration * 2, SpawningParticleDuration]
                                                CustomFloat3_1 = GenFloat3[RandomRange[1, 20], 0, 0]
                                            ),
                                            private texture_chooser is Initialiser_TextureSmallIndex
                                            (
                                                InitFunction = DarkFire_Textures_Anim_Table[ round[$/VFX_Bank/RandomUnit] ]
                                            ),
                                        ]
                                        ParticleDescriptor = ParticleDescriptor
                                        (
                                            ParticleRenderer = $/VFX_Bank/LitParticleRenderer
                                            RenderInfo = ParticleRenderInfo
                                            (
                                                ZTest = True
                                                SortTriangles = True
                                                Use3DRotation = True
                                                TextureName = 'GameData:/Assets/2D/Fx/anim_flame_01_000.png'
                                                ZWrite = False
                                                Calque = 'Particles'
                                                EmissiveParticle = True
                                            )
                                            Evolvers = ParticleStandardEvolverListWithPhysic
                                            (
                                                FluidFriction = 0
                                                Size = ( ParticleCustomFloat_1 + ( 40 * ParticleCustomFloat_5 * ParticleCustomFloat_4 * ParticleElapsedTime ) ) * ParticleCustomFloat_2 * lerp[Min[Distance[ParticlePosition, $/VFX_Bank/CameraPosition] div 500000, 1], 1, 3] * ParticleCustomFloat_3
                                                EmissivePower = ( ( getX[ParticleCustomFloat3_1] + RandomRange[1, 2] ) * ParticleCustomFloat_6 ) * Triangle[ParticleLifeRatio]
                                                                * AttackSustainDecay[ParticleLifeRatio, 0.2, 0.8] * ParticleCustomFloat_6 * ParticleCustomFloat_4 * 0.01
                                                ZBias = ( ParticleCustomFloat_1 + ( 40 * ParticleCustomFloat_5 * ParticleCustomFloat_4 * ParticleElapsedTime ) ) * ParticleCustomFloat_2 * lerp[Min[Distance[ParticlePosition, $/VFX_Bank/CameraPosition] div 500000, 1], 1, 3] * 2
                                                UseHardCodedRotation = False
                                                Stretching = 1 div ParticleCustomFloat_3
                                                Direction = float3[0.05, 0.05, 1.00] * $/VFX_Bank/MapWind
                                                AdditionnalEvolvers =
                                                [
                                                    Template_TextureAnimation
                                                    (
                                                        EvolveFunction = Sawtooth[ParticleElapsedTime * 0.15] //0.15
                                                    ),
                                                ]
                                            )
                                        )
                                    )
                                )
                                ]
                            )
                        )
                    )
                ),

                private flammes_Main is ParticleBombSpawner
                (
                    ParticleMaxDurationForSpawnSkip = (Duration + 6) * 1.1
                    Count = 1
                    Spawner = private Spawner is ParticleSpawner
                    (
                        ParticleLifetime = Duration
                        Initialisers =
                        [
                            ParticleInitialiserList
                            (
                                ColorModifier = float3[1, 1, 1]

                                Size = Ground_Size
                                ColorRGB = LinearColor[1.00, 1.00, 1.00]
                                Alpha = 1
                                ColorMultiplier = 1
                                CustomFloat_1 = Feu_Size_Mul * 7
                                CustomFloat_2 = PCount_FireMul
                                CustomFloat_3 = 2
                            ),
                            Initialiser_SetMobileWrapper(),
                        ]
                        ParticleDescriptor = ParticleDescriptor
                        (
                            ParticleRenderer = $/VFX_Bank/NullRenderer
                            RenderInfo = $/VFX_Bank/NullRenderInfo
                            Evolvers = Template_List
                            (
                                Evolvers =
                                [
                                Template_EvolverField
                                (
                                    EvolveFunction = ParticleMobileWrapperPositionUnScaled
                                    Field = 'Position'
                                ),
                                EvolverSpraySpawner
                                (
                                    Frequency = RandomRange[0.25, 0.35]
                                    MaxSpawnedParticleLifetime = 6
                                    Spawner = private Flammes is ParticleSpawner
                                    (
                                        ParticleLifetime = RandomRange[3, 6]
                                        Initialisers =
                                        [
                                            private particules_flammes is ParticleInitialiserList
                                            (
                                                Alpha = 1.0

                                                Position = float3[0.00, 0.00, 175.00]
                                                Size = 1
                                                ColorModifier = LinearColor[1.00, 1.00, 0.80]
                                                EmissivePower = 1
                                                Opacity = 0
                                                CustomFloat_1 = RandomRange[200, 300] * SpawningParticleCustomFloat_1
                                                CustomFloat_2 = 4 * SpawningParticleCustomFloat_3 + RandomRange[0, 5]
                                                CustomFloat_3 = RandomRange[0.9, 1.2]
                                                CustomFloat_4 = sat[SpawningParticleElapsedTime * 0.0125]
                                                CustomFloat_6 = 1 - MapToLinearSmoothStep[SpawningParticleElapsedTime, SpawningParticleDuration - ParticleDuration * 2, SpawningParticleDuration]
                                            ),
                                            private texture_chooser is Initialiser_TextureSmallIndex
                                            (
                                                InitFunction = ~/DarkFire_Textures_Anim_Table[round[$/VFX_Bank/RandomUnit]]
                                            ),
                                        ]
                                        ParticleDescriptor = ParticleDescriptor
                                        (
                                            ParticleRenderer = $/VFX_Bank/LitParticleRenderer
                                            RenderInfo = ParticleRenderInfo
                                            (
                                                ZTest = True
                                                SortTriangles = True
                                                Use3DRotation = True
                                                TextureName = 'GameData:/Assets/2D/Fx/anim_flame_01_000.png'
                                                ZWrite = False
                                                Calque = 'Particles'
                                                EmissiveParticle = True
                                            )
                                            Evolvers = ParticleStandardEvolverListWithPhysic
                                            (
                                                FluidFriction = 0.1
                                                PhysicWindField = normalized[$/VFX_Bank/MapWind] * 100
                                                Size = lerp[ParticleLifeRatio, ParticleCustomFloat_1 * 0.75, ParticleCustomFloat_1] * ParticleCustomFloat_3
                                                EmissivePower = ParticleCustomFloat_2 * Triangle[ParticleLifeRatio] * ParticleCustomFloat_6 * 0.15 * ParticleCustomFloat_4 * 0.1
                                                ZBias = lerp[ParticleLifeRatio, 0.375, 0.625] * ParticleCustomFloat_1
                                                Stretching = 1 div ParticleCustomFloat_3
                                                Direction = float3[0.10, 0.10, 1.00] * $/VFX_Bank/MapWind
                                                UseHardCodedRotation = False
                                                AdditionnalEvolvers =
                                                [
                                                    Template_TextureAnimation
                                                    (
                                                        EvolveFunction = Sawtooth[ParticleElapsedTime * 0.15] // 0.25
                                                    ),
                                                ]
                                            )
                                        )
                                    )

                                )
                                ]
                            )
                        )
                    )
                ),

            ]
            RadiusForMultiLaunchSkip = Ground_Size div 2
            DurationForMultiLaunchSkip = 10
        ),
    ]
)
private DarkFire_Color_Table is Template_Float3Table
(
    Values =
    [
        [0.10, 0.10, 0.10],
        [0.20, 0.20, 0.20],
        [0.30, 0.30, 0.30],
    ]
    Interpolate = True
)
public DarkFire_SmokeSpeed_Behavior is Template_FloatTable
(
    Values =
    [
        0.5,
        0.8,
        0.33,
        0.1,
        0,
    ]
    Interpolate = True
)
public DarkFire_Textures_Anim_Table is Template_EvaluableTable
(
    Values =
    [
        private Feu01 is TConstantTexture (TextureName = 'GameData:/Assets/2D/Fx/anim_flame_01_000.png' ),
    ]
)
public DarkFire_Textures_Table is Template_EvaluableTable
(
    Values =
    [
        private Feu01 is TConstantTexture (TextureName = 'GameData:/Assets/2D/Fx/flame_01.png' ),
        private Feu02 is TConstantTexture (TextureName = 'GameData:/Assets/2D/Fx/flame_02.png' ),
    ]
)
